# Port server lokal (dibuka di browser: http://127.0.0.1:3000)
PORT=3000

# Alamat tempat server mendengarkan. Kosongkan untuk komputer ini saja (127.0.0.1).
# Di server yang harus bisa diakses dari luar, isi 0.0.0.0.
# HOST=0.0.0.0


# Alamat yang dibuka browser untuk server ini. Dipakai untuk redirect Spotify.
# Di server publik, isi dengan alamat https, misalnya:
# PUBLIC_URL=https://streamover.khincreator.com

# Username TikTok default, tanpa tanda @. Bisa juga diisi lewat panel kontrol.
TIKTOK_USERNAME=

# YouTube Data API key (Google Cloud, aktifkan YouTube Data API v3). Dipakai untuk mencari request dari chat.
# YOUTUBE_API_KEY=

# Apple Music (opsional). Butuh akun Apple Developer berbayar dan kunci MusicKit (.p8).
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=KEY1234567
# APPLE_PRIVATE_KEY_FILE=/path/ke/AuthKey_KEY1234567.p8

# --- Contoh untuk https://streamover.khincreator.com (di belakang Caddy, lihat deploy/Caddyfile) ---
# PORT=3000
# HOST=127.0.0.1
# PUBLIC_URL=https://streamover.khincreator.com
