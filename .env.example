# Port server lokal (dibuka di browser: http://127.0.0.1:3000)
PORT=3000

# Alamat tempat server mendengarkan. Kosongkan untuk komputer ini saja (127.0.0.1).
# Di server yang harus bisa diakses dari luar, isi 0.0.0.0 dan wajib isi PANEL_PASSWORD.
# HOST=0.0.0.0

# Password untuk masuk ke panel. Wajib kalau HOST bukan 127.0.0.1.
# Kosongkan untuk komputer ini saja (panel terbuka tanpa login).
# PANEL_PASSWORD=

# Alamat yang dibuka browser untuk server ini. Dipakai untuk redirect Spotify.
# Di server publik, isi dengan alamat https, misalnya https://nama-anda.example.com
# PUBLIC_URL=

# Username TikTok default, tanpa tanda @. Bisa juga diisi lewat panel kontrol.
TIKTOK_USERNAME=
