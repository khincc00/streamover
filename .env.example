# Port server lokal (dibuka di browser: http://127.0.0.1:3000)
PORT=3000

# Alamat tempat server mendengarkan. Kosongkan untuk komputer ini saja (127.0.0.1).
# Di server yang harus bisa diakses dari luar, isi 0.0.0.0.
# HOST=0.0.0.0


# Alamat yang dibuka browser untuk server ini. Dipakai untuk redirect Spotify.
# Di server publik, isi dengan alamat https, misalnya:
# PUBLIC_URL=https://streamover.khincreator.com

# Username TikTok default, tanpa tanda @. Bisa juga diisi lewat panel kontrol.
TIKTOK_USERNAME=
