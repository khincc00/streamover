{
  "manifest_version": 3,
  "name": "Streamover YT Music",
  "version": "1.0.0",
  "description": "Mengirim lagu yang sedang diputar di YouTube Music ke Streamover.",
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:3000/*"],
      "js": ["panel-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": ["http://127.0.0.1:3000/*"]
}
